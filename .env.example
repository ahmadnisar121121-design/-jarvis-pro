# Copy this to .env for local dev with `netlify dev` (never commit the real .env).
# In production, set these under Netlify → Site settings → Environment variables.

OPENROUTER_API_KEY=sk-or-v1-...
# Optional — defaults to the free GLM 5.2 endpoint (z-ai/glm-5.2:free).
# Swap to any other OpenRouter model id if you want a different model.
OPENROUTER_MODEL=z-ai/glm-5.2:free
# Optional — used in the OpenRouter attribution header, set to your deployed URL.
SITE_URL=https://your-site.netlify.app
